@using static GenstarXKulayInventorySystem.Shared.Helpers.ProductsEnumHelpers
@using GenstarXKulayInventorySystem.Shared.DTOS;

<MudDialog>
    <DialogContent>
        <MudGrid>
            <!-- Brand -->
            <MudItem xl="6" lg="6" sm="12">
                <MudAutocomplete T="ProductBrandDto"
                                 Label="Select Brand"
                                 Dense="true"
                                 Placeholder="Type or select brand"
                                 SearchFunc="SearchBrands"
                                 Value="SelectedBrand"
                                 ValueChanged="OnBrandSelect"
                                 ToStringFunc="b => b?.BrandName"
                                 MaxItems="100"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="false" />
            </MudItem>

            <!-- Product -->
            <MudItem xl="6" lg="6" sm="12">
                <MudAutocomplete T="ProductDto"
                                 Label="Product Name"
                                 Dense="true"
                                 Placeholder="Type or select product"
                                 SearchFunc="SearchProducts"
                                 Value="SelectedProduct"
                                 ValueChanged="OnProductSelect"
                                 ToStringFunc="p => p?.ProductNameAndUnit"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="false"
                                 MaxItems="300" />
            </MudItem>

            <!-- Unit -->
            <MudItem xl="6" lg="6" sm="12">
                <MudSelect T="ProductMesurementOption?"
                           Label="Unit"
                           @bind-Value="PurchaseOrderItemDto.PurchaseItemMeasurementOption"
                           Dense="true"
                           Disabled="true"
                           FullWidth="true">
                    @foreach (var unit in Enum.GetValues(typeof(ProductMesurementOption)).Cast<ProductMesurementOption>())
                    {
                        <MudSelectItem T="ProductMesurementOption?" Value="@unit">@unit.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Quantity -->
            <MudItem xl="6" lg="6" sm="12">
                <MudNumericField T="int"
                                 @bind-Value="PurchaseOrderItemDto.ItemQuantity"
                                 Label="Quantity"
                                 FullWidth="true"
                                 HideSpinButtons="true"
                                 Required="true"
                                 RequiredError="Quantity required" />
            </MudItem>

            <!-- Item Amount -->
            <MudItem xl="6" lg="6" sm="12">
                <MudNumericField T="decimal?"
                                 @bind-Value="PurchaseOrderItemDto.ItemAmount"
                                 Label="Item Amount"
                                 Adornment="Adornment.Start"
                                 AdornmentText="₱"
                                 Format="N2"
                                 HideSpinButtons="true"
                                 Placeholder="Price per item"
                                 FullWidth="true" />
            </MudItem>

            <!-- Description -->
            <MudItem xl="12" sm="12">
                <MudTextField T="string"
                              Variant="Variant.Outlined"
                              @bind-Value="PurchaseOrderItemDto.ItemDescription"
                              Label="Description"
                              Lines="3"
                              MaxLines="5"
                              FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Submit" Disabled="!IsValid">Add</MudButton>
    </DialogActions>
</MudDialog>
