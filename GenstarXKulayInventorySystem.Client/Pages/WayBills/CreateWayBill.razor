@page "/create-WayBill"
@using GenstarXKulayInventorySystem.Client.Pages.WayBills.WayBillItems
@using GenstarXKulayInventorySystem.Shared.DTOS
@using GenstarXKulayInventorySystem.Shared.Helpers
@using static GenstarXKulayInventorySystem.Shared.Helpers.WalBillHelper
@layout MainLayout

<MudMainContent Class="w-auto h-100 ">
    <MudText Typo="Typo.h6" Class="mb-4 pa-5">
        Create Way Bill
    </MudText>
    @if (IsLoading)
    {
        <MudCard Elevation="10" Class="pa-6 d-flex flex-column align-items-center justify-content-center gap-3">
            <MudProgressCircular Indeterminate="true" Rounded="true" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Align="Align.Center">Loading</MudText>
        </MudCard>
    }
    else
    {
        <MudCard Elevation="0" Class="pa-6">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                    Label="Supplier Name"
                    @bind-Value="SupplierName"
                    SearchFunc="SearchSupplier"
                    Dense="true"
                    Clearable="true"
                    CoerceText="true"
                    CoerceValue="true"
                    Placeholder="Enter Supplier Name"
                    Variant="Variant.Text"
                    Required="true"
                    TextChanged="OnSupplierNameType"
                    ShowProgressIndicator="IsSupplierLoading" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="WayBill.WayBillNumber" Placeholder="Way Bill Number" Variant="Variant.Text" Label="Way Bill No." Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="WayBill.Courier" Placeholder="Courier Name" Label="Courier" Variant="Variant.Text"/>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="WayBillTermsOption"
                               Label="Way Bill Terms"
                              Value="WayBill.WayBillTerms"
                              ValueChanged="OnTermsChange">

                        @foreach (WayBillTermsOption option in Enum.GetValues(typeof(WayBillTermsOption)))
                        {
                            <MudSelectItem Value="option">
                                @WalBillHelper.GetWayBillTermsText(option)
                                                        </MudSelectItem>
                        }

                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker Date="WayBill.DateReceived" Label="Date Receive" DateFormat="MMMM dd, yyyy" Elevation="5" MaxDate="WayBill.DateReceived.AddDays(1)" DateChanged="OnDateReceiveChange" />
                </MudItem>
              
               <MudItem xs="12" class="d-flex flex-column gap-1">
                   <label>Notes <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Default" Size="Size.Small"/></label>
                   <MudTextField @bind-Value="WayBill.Notes" Lines="2" MaxLines="5" Variant="Variant.Outlined"/>
               </MudItem>
                <MudItem xs="12" md="12">
                   <GetAllWayBillItems @ref="WayBillItemsComponent"
                       Branch="Branch"
                       OnItemsChanged="RecalculateIsValid"/>


                </MudItem>
                <MudItem xs="12" Class="d-flex flex-row justify-content-end align-items-center gap-3">
                    <MudButton 
                        StartIcon="@Icons.Material.Filled.Cancel"
                        Variant="Variant.Filled" 
                        OnClick="Cancel"
                        Color="Color.Default">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SubmitWayBill"
                               Disabled="!IsValid">
                        Submit Way Bill
                    </MudButton>

                </MudItem>
            </MudGrid>
        </MudCard>
    }
  </MudMainContent>
