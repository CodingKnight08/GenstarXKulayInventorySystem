@using static GenstarXKulayInventorySystem.Shared.Helpers.OrdersHelper
@using static GenstarXKulayInventorySystem.Shared.Helpers.UtilitiesHelper
@using GenstarXKulayInventorySystem.Shared.DTOS;

    <MudCard Elevation="0" Class="d-flex w-100 flex-row align-items-center justify-content-end">
        <MudButton
            StartIcon="@Icons.Material.Filled.AddCircle" 
            OnClick="CreateSaleAsync"
            Variant="Variant.Filled"
            Color="Color.Info" 
            Class="me-4">Add Sales</MudButton>
    </MudCard>
@if (IsLoading)
{
    <MudCard Elevation="0" Class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
        <MudProgressCircular Indeterminate=true Color="Color.Info" Size="Size.Medium" Rounded=true/>
        <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">Loading Data..</MudText>
      
    </MudCard>
}
else
{
    

<MudCard Elevation="0" Class="w-100 mx-2 mt-5 px-3">
    <MudGrid Spacing="4">
        <MudItem  xl="2" xs="12" sm="6" lg="4" md="6">
                <MudDatePicker Label="Date of Sales"
                               Date="SelectedDate"
                               DateChanged="OnDateChanged"
                               MaxDate="@Today"
                               PickerVariant="PickerVariant.Inline"
                               Class="mb-4" />
        </MudItem>
        <MudItem md="6" lg="6" sm="6" xs="12">
           <MudTextField T="string"
              Value="SearchText"
              ValueChanged="OnSearchChanged"
              Placeholder="Enter Here"
              Label="Search"
              Adornment="Adornment.End"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Text"
              Immediate="true"
              Clearable="true" />
        
        </MudItem>
        <MudItem md="4" lg="3">
               <MudSelect T="SaleSearchCategory"
                       Label="Search By"
                       Value="SelectedSearchCategory"
                       ValueChanged="OnSearchCategoryChanged"
                       Dense>
                    <MudSelectItem Value="SaleSearchCategory.ReceiptNumber">Receipt Number</MudSelectItem>
                    <MudSelectItem Value="SaleSearchCategory.ClientName">Client Name</MudSelectItem>
                </MudSelect>
        </MudItem>
        <MudItem xl="12" lg="12" md="12" sm="12">
                <MudTable T="DailySaleDto" 
                          Items="FilteredSales"
                          RowsPerPage="@PageTake"
                          CurrentPage="@CurrentPageIndex"
                          CurrentPageChanged="OnPageChanged"
                          RowsPerPageChanged="OnRowsPerPageChanged"
                          Dense=true
                          Hover=true
                          Square=true
                          Striped=true
                          Bordered=true>

                    <HeaderContent>
                        <MudTh>Time of Sale</MudTh>
                        <MudTh>Sale No.</MudTh>
                        <MudTh>Receipt No.</MudTh>
                        <MudTh>Client</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            @context.DateOfSales.ToString("hh:mm tt")
                        </MudTd>

                        <MudTd>@context.SalesNumber</MudTd>
                        <MudTd>@context.RecieptReference</MudTd>
                        <MudTd>@context.NameOfClient</MudTd>
                        <MudTd>@(context.SalesOption == PurchaseRecieptOption.BIR ? "Invoice" : "Non-Voice")</MudTd>
                        <MudTd>
                            <MudText Color="@(context.IsApproved? Color.Success: Color.Warning)" Typo="Typo.subtitle2">
                                @(context.IsApproved ? "Approved" : "Pending")
                            </MudText>
                        </MudTd>

                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="() => ViewSaleAsync(context.Id)" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.subtitle2" Align="Align.Center">No Current Sales</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="@(new int[] { 5, 10, 20 })" />
                    </PagerContent>
                </MudTable>
        </MudItem>
    </MudGrid>
       

       
    </MudCard>
}