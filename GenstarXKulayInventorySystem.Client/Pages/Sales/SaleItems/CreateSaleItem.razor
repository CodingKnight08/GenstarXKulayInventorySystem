@using GenstarXKulayInventorySystem.Client.Pages.Sales.SaleItems.PaintIncluded
@using static GenstarXKulayInventorySystem.Shared.Helpers.ProductsEnumHelpers
@using GenstarXKulayInventorySystem.Shared.DTOS;
<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xl="4" lg="6" md="6" sm="12">
                <MudAutocomplete T="ProductBrandDto"
                                 Label="Select Brand"
                                 Dense="true"
                                 Placeholder="Select Brand"
                                 SearchFunc="SearchBrands"
                                 Value="SelectedBrand"
                                 ValueChanged="OnBrandSelect"
                                 ToStringFunc="b => b?.BrandName"
                                 Disabled="SaleItemDto.PaintCategory == PaintCategory.Mix"
                                 MaxItems="100"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="false" />

            </MudItem>
            @if (SaleItemDto.PaintCategory != PaintCategory.Mix)
            {


                <MudItem xl="5" lg="6" md="6" sm="12">

                <MudAutocomplete T="ProductDto"
                                 Label="Item Name"
                                 Dense="true"
                                 Placeholder="Select Item"
                                 SearchFunc="SearchProductsDto"
                                 Value="SelectedProductFromList"
                                 ValueChanged="OnProductSelectDto"
                                 ToStringFunc="p => p?.ProductName"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="false"
                                 MaxItems="500" />
                </MudItem>
            }
            else
            {
                
       
            <MudItem>
                <MudTextField T="string" Value="SelectedProduct" Variant="Variant.Text" Label="Item Name" ValueChanged="OnProductTyped"/>
            </MudItem>
            }
            <MudItem xl="3" lg="5" md="6" sm="12">
                <MudSelect T="PaintCategory" Value="SaleItemDto.PaintCategory" Label="Paint Type" ValueChanged="OnPaintCategoryChange" >
                    @foreach(var type in Enum.GetValues(typeof(PaintCategory)).Cast<PaintCategory>())
                    {
                        <MudSelectItem T="PaintCategory" Value="@type">
                            @type.ToString()
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xl="3" lg="6" md="6" sm="12">
                <MudNumericField T="decimal?" Value="SaleItemDto.Size"  Placeholder="Item Size eg. 1.5ml" Label="Item Size" HideSpinButtons="true" Variant="Variant.Text" Required=true ValueChanged="OnSizeChanged"/>
            </MudItem>
            <MudItem xl="3" lg="5" md="6" sm="12">
                <MudSelect T="ProductMesurementOption" @bind-Value="SaleItemDto.UnitMeasurement" Label="Unit" Disabled="@(SaleItemDto.ProductId !=null)">
                    @foreach(var unit in Enum.GetValues(typeof(ProductMesurementOption)).Cast<ProductMesurementOption>())
                    {
                        <MudSelectItem T="ProductMesurementOption" Value="@unit">
                            @unit.ToString()
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xl="3" lg="5" md="6" sm="12">
                <MudNumericField T="decimal" Value="SaleItemDto.Quantity" Label="Quantity" Placeholder="Enter Quantity" HideSpinButtons=true ValueChanged="OnQuantityChanged"/> 
            </MudItem>
            
            
            <MudItem xl="3" lg="5" md="6" sm="12">
                <MudNumericField T="decimal" Value="PriceItem" Adornment="Adornment.Start" AdornmentText="₱" HideSpinButtons="true" Label="Price per Item" Format="F2" ValueChanged="Trial"/>
             </MudItem>
            <MudItem xl="3" lg="5" md="6" sm="12">
                     <MudNumericField T="decimal" Value="SaleItemDto.TotalPrice" Adornment="Adornment.Start" AdornmentText="₱" HideSpinButtons="true" Label="Total Price" Format="N2" ReadOnly="true"  />
                </MudItem>
            @if (ShouldShowSaleType())
            {
                <MudItem xl="3" lg="5" md="6" sm="12">
                    <MudCheckBox T="bool" @bind-Checked="IsWholeSale" Label="Wholesale Price?" Size="Size.Small" ValueChanged="OnWholeSaleChanged" />
                </MudItem>
            }
            
          
            <MudItem xl="12" lg="12" sm="12">
                <MudTextField @bind-Value="SaleItemDto.Description" MaxLines="2" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Info" Label="Description" />
            </MudItem>
            @if (SaleItemDto.PaintCategory == PaintCategory.Mix)
            {
                <MudItem xl="12" Class="d-flex flex-row justify-content-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" DropShadow="true" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AddPaintIncluded">Add Material</MudButton>
                </MudItem>
                <MudItem xl="12">
                    <GetAllPaintsIncluded PaintItems="Paints"/>
            </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveItem" Disabled="!IsValid">Add</MudButton>
    </DialogActions>
</MudDialog>