<MudCard Elevation="0" Class="w-100 my-4 d-flex flex-column gap-2">
    <MudCard Elevation="0" Class="w-100 d-flex flex-row justify-content-end">
        <MudButton StartIcon="@Icons.Material.Filled.AddCircle" Class="float-end" Variant="Variant.Filled" Color="Color.Info" OnClick="AddSaleItem"> Add Item</MudButton>
    </MudCard>
    <MudCard Elevation="5" Class="w-100">
        <MudTable Items="SaleItemsToBeAdded" Bordered=true Hover=true Dense=true RowsPerPage="6">
            <HeaderContent>
                <MudTh>Item Name</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Unit</MudTh>
                <MudTh>Quantity</MudTh>
                <MudTh>Paint Category</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>Item Amount</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ItemName</MudTd>
                <MudTd>@context.Size</MudTd>
                <MudTd>@context.UnitMeasurement</MudTd>
                <MudTd>@context.Quantity</MudTd>
                <MudTd>@context.PaintCategory</MudTd>
                <MudTd>₱ @String.Format("{0:N2}", context.ItemPrice)</MudTd>
                <MudTd>₱ @String.Format("{0:N2}", context.TotalPrice)</MudTd>
                <MudTd>
                    <MudIconButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" OnClick="@(() => RemoveSaleItem(context))" />
                </MudTd>

            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.subtitle2" Align="Align.Center" Color="Color.Warning">
                    No Sale Item Products
                </MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
            </PagerContent>
        </MudTable>
        
    </MudCard>
    <MudCard Elevation="0" Class="d-flex flex-row align-items-center justify-content-end mt-4">
        <MudItem sm="4">
            <MudNumericField T="decimal"
                             HideSpinButtons="true"
                             Value="TotalAmount"
                             FullWidth="false"
                             Format="N2"
                             Adornment="Adornment.Start"
                             AdornmentText="₱"
                             AdornmentColor="Color.Default"
                             Label="Total Amount" Variant="Variant.Text" 
                             ReadOnly=true/>
        </MudItem>
        
    </MudCard>
</MudCard>
