@using static GenstarXKulayInventorySystem.Shared.Helpers.ProductsEnumHelpers
@using GenstarXKulayInventorySystem.Shared.DTOS;
<MudDialog>
    <DialogContent>
        <MudGrid Spacing="6">
            <MudItem xl="6" xs="12">
                <MudAutocomplete T="ProductBrandDto"
                                 Label="Select Brand"
                                 Dense="true"
                                 Placeholder="Select Brand"
                                 SearchFunc="SearchBrands"
                                 Value="SelectedBrand"
                                 ValueChanged="OnBrandSelect"
                                 ToStringFunc="b => b?.BrandName"
                                 MaxItems="100"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="false" />
            </MudItem>
            <MudItem xl="6">
                <MudAutocomplete T="BranchProductDto"
                                 Label="Select Product"
                                 Dense="true"
                                 Clearable="true"
                                 Value="SelectedProduct"
                                 ResetValueOnEmptyText="true"
                                 SearchFunc="SearchProducts"
                                 ValueChanged="OnProductSelect"
                                 ToStringFunc="p => p?.MasterProduct?.ProductName ?? string.Empty"
                                 MaxItems="500"
                                 Placeholder="Type to search product..."
                                 ShowProgressIndicator="IsProductLoading" />
            </MudItem>
            <MudItem xl="3">
                <MudSelect T="ProductMesurementOption" @bind-Value="AddedPaint.UnitMeasurement" Label="Unit">
                    @foreach (var unit in Enum.GetValues(typeof(ProductMesurementOption)).Cast<ProductMesurementOption>())
                    {
                        <MudSelectItem T="ProductMesurementOption" Value="@unit">
                            @unit.ToString()
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xl="4">
                <MudNumericField T="decimal?" Label="Size" Value="AddedPaint.Size" Variant="Variant.Text" Placeholder="Enter Size eg. 1000 (ml)" ValueChanged="OnSizeChanged" HideSpinButtons=true />
            </MudItem>
            <MudItem xs="12" xl="4" lg="4">
                <MudNumericField T="decimal" Label="Quantity" Value="AddedPaint.Quantity" Variant="Variant.Text" Placeholder="Enter Quantity" ValueChanged="OnQuantityChanged" Max="GetMaxQuantity()" HideSpinButtons=true />
            </MudItem>
            <MudItem xl="4">
                <MudNumericField T="decimal" Label="Total Cost" Value="AddedPaint.ProductCost" Variant="Variant.Text" ReadOnly="true" Format="F2" HideSpinButtons=true />
            </MudItem>

        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="Add" Disabled="!IsValid" >Add</MudButton>
    </DialogActions>
</MudDialog>