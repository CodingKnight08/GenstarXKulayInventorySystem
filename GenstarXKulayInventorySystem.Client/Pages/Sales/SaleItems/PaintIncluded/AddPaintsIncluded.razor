@using static GenstarXKulayInventorySystem.Shared.Helpers.ProductsEnumHelpers
@using GenstarXKulayInventorySystem.Shared.DTOS

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>
        <MudGrid Spacing="3">

            <!-- Brand selection -->
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="ProductBrandDto"
                                 Label="Select Brand"
                                 Dense="true"
                                 Placeholder="Select Brand"
                                 SearchFunc="SearchBrands"
                                 Value="SelectedBrand"
                                 ValueChanged="OnBrandSelect"
                                 ToStringFunc="b => b?.BrandName"
                                 MaxItems="100"
                                 Clearable="true" />
            </MudItem>

            <!-- Product selection -->
            <MudItem xs="12" sm="6">
                <MudAutocomplete T="ProductDto"
                                 Label="Select Product"
                                 Dense="true"
                                 Clearable="true"
                                 Value="SelectedProduct"
                                 ValueChanged="OnProductSelect"
                                 ToStringFunc="p => p.ProductName"
                                 SearchFunc="SearchProducts"
                                 MaxItems="500"
                                 Placeholder="Type to search product..."
                                 ShowProgressIndicator="IsProductLoading" />
            </MudItem>

            <!-- Size input -->
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal?"
                                 Label="Size"
                                 Value="AddedPaint.Size"
                                 Variant="Variant.Text"
                                 Placeholder="Enter Size (e.g., 1000 ml)"
                                 Immediate="true"
                                 HideSpinButtons="true"
                                 ValueChanged="OnSizeChanged" />
            </MudItem>

            <!-- Quantity input -->
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal"
                                 Label="Quantity"
                                 Value="AddedPaint.Quantity"
                                 Variant="Variant.Text"
                                 Placeholder="Enter Quantity"
                                 HideSpinButtons="true"
                                 Immediate="true"
                                 ValueChanged="@(v => OnValueChanged(v))" />
            </MudItem>

            <!-- Unit selection -->
            <MudItem xs="12" sm="4">
                <MudSelect T="ProductMesurementOption"
                           @bind-Value="AddedPaint.UnitMeasurement"
                           Label="Unit"
                           Dense="true">
                    @foreach (var unit in Enum.GetValues(typeof(ProductMesurementOption)).Cast<ProductMesurementOption>())
                    {
                        <MudSelectItem T="ProductMesurementOption" Value="@unit">@unit</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Display calculated amount -->
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Color="Color.Info" Class="text-end">
                    Total Amount: ₱ @AddedPaint.TotalCost.ToString("N2")
                </MudText>
            </MudItem>

        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small" OnClick="Cancel">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="Add" Disabled="!IsValid">
            Add
        </MudButton>
    </DialogActions>
</MudDialog>
