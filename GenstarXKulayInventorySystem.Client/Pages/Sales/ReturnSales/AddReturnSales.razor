@using static GenstarXKulayInventorySystem.Shared.Helpers.ProductsEnumHelpers
@using GenstarXKulayInventorySystem.Shared.DTOS;
<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xl="4" lg="6" md="6" sm="12">
                <MudAutocomplete T="ProductBrandDto"
                                 Label="Select Brand"
                                 Dense="true"
                                 Placeholder="Select Brand"
                                 SearchFunc="SearchBrands"
                                 Value="SelectedBrand"
                                 ValueChanged="OnBrandSelect"
                                 ToStringFunc="b => b?.BrandName"
                                 MaxItems="100"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="false" />

            </MudItem>
            <MudItem xl="5" lg="6" md="6" sm="12">

                <MudAutocomplete T="BranchProductDto"
                                 Label="Item Name"
                                 Dense="true"
                                 Placeholder="Select Item"
                                 SearchFunc="SearchProductsDto"
                                 Value="SelectedProduct"
                                 ValueChanged="OnProductSelectDto"
                                 ToStringFunc="p => p?.MasterProduct?.ProductName ?? string.Empty"
                                 Clearable="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="false"
                                 MaxItems="500" />
            </MudItem>
            <MudItem xl="3" lg="5" md="6" sm="12">
                <MudNumericField T="decimal" Value="ReturnItem.Quantity" Label="Quantity" Placeholder="Enter Quantity" HideSpinButtons=true ValueChanged="OnQuantityChanged" />
            </MudItem>
            <MudItem xl="3" lg="5" md="6" sm="12">
                <MudNumericField T="decimal" Value="PriceItem" Adornment="Adornment.Start" AdornmentText="₱" HideSpinButtons="true" Label="Price per Item" Format="F2" ValueChanged="PriceChange" />
            </MudItem>
            <MudItem xl="3" lg="5" md="6" sm="12">
                <MudNumericField T="decimal" Value="ReturnItem.TotalPrice" Adornment="Adornment.Start" AdornmentText="₱" HideSpinButtons="true" Label="Total Price" Format="F2" ReadOnly=true />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveItem" Disabled="!IsValid">Add</MudButton>
    </DialogActions>
</MudDialog>