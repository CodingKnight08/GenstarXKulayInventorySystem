@using GenstarXKulayInventorySystem.Shared.DTOS
@using static GenstarXKulayInventorySystem.Shared.Helpers.ProductsEnumHelpers
<MudDialog>
    <DialogContent>
        <MudGrid Spacing="10">
            @if (!IsLoading)
            {
                <MudItem sm="12" md="6" lg="6">
                    <MudAutocomplete 
                    T="GlobalProductDto" 
                    Label="Product Name" 
                    Placeholder="Select Product"
                    SearchFunc="SearchMasterProduct"
                    ValueChanged="OnGlobalProductSelect"
                    Value="SelectedMasterProduct"
                    ToStringFunc="p => p.ProductName"
                    Clearable ="true"
                    CoerceText="false"
                    CoerceValue="false"
                    ResetValueOnEmptyText="false"
                    MaxItems="100"
                    Variant="Variant.Text"
                    />

                </MudItem>
                <MudItem sm="12" md="6" lg="6">
                    <MudSelect T="ProductMesurementOption ?"
                               @bind-Value="NewBranchProduct.ProductMesurementOption"
                               Label="Unit">

                        @foreach (var unit in Enum.GetValues<ProductMesurementOption>())
                        {
                            <MudSelectItem T="ProductMesurementOption ?" Value="@unit">
                                @unit.ToString()
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudNumericField 
                        Variant="Variant.Text"
                        T="decimal?" 
                        Label="Cost price"
                        @bind-Value="NewBranchProduct.CostPrice" 
                        Adornment="Adornment.Start" 
                        AdornmentText="P"
                        HideSpinButtons=true
                        Format="N2"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField
                        @bind-Value="NewBranchProduct.WholeSalePrice"
                        Label="Wholesale Price"
                        Variant="Variant.Text" 
                        Adornment="Adornment.Start" 
                        AdornmentText="P" 
                        HideSpinButtons="true"
                        Format="N2"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField
                        @bind-Value="NewBranchProduct.RetailPrice"
                        Label="Retail Price"
                        Variant="Variant.Text" 
                        Adornment="Adornment.Start" 
                        AdornmentText="P" 
                        HideSpinButtons=true
                        Format="N2"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField
                        T="decimal?"
                        @bind-Value="NewBranchProduct.WholeSaleCostPrice"
                         Label="Wholesale Landed"
                         Variant="Variant.Text"
                         Adornment="Adornment.Start"
                         AdornmentText="P"
                         HideSpinButtons="true"
                         Format="N2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField
                        @bind-Value="NewBranchProduct.ActualQuantity"
                         Label="Quantity"
                         Variant="Variant.Text"
                         HideSpinButtons="true"
                         Format="N2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="NewBranchProduct.BufferStocks"
                                     Label="Buffer Stocks"
                                     Variant="Variant.Text"
                                     HideSpinButtons="true"
                                     Format="N2" />
                </MudItem>
            }
            else
            {
               <MudItem sm="12" Class="d-flex flex-column align-items-center justify-content-center gap-2">
                   <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Info" />
                   <MudText Typo="Typo.subtitle1" Align="Align.Center">Loading</MudText>
               </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton 
            Variant="Variant.Filled" 
            Color="Color.Default"
            Size="Size.Small"
            OnClick="Cancel"
            StartIcon="@Icons.Material.Filled.Cancel">Cancel
        </MudButton>
        <MudButton 
            Variant="Variant.Filled" 
            Color="Color.Success" 
            Size="Size.Small"
            OnClick="Submit"
            Disabled="@IsSubmitDisabled"
            StartIcon="@Icons.Material.Filled.Save">Save</MudButton>
    </DialogActions>
</MudDialog>