@page "/view-pull-out-request/{PullOutId:int}"
@using GenstarXKulayInventorySystem.Shared.Helpers
@using static GenstarXKulayInventorySystem.Shared.Helpers.UtilitiesHelper


<MudMainContent Class="w-auto h-100 d-flex flex-column gap-3">
    <PageTitle>Pull Out Details</PageTitle>
    <MudBreadcrumbs Items="_items"></MudBreadcrumbs>
    <MudCard Class="px-5 d-flex flex-column align-content-center">

        @if (IsLoading)
        {
            <MudCard Elevation="0" Class="w-100 d-flex justify-content-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </MudCard>
        }
        else if (PullOutRequest == null)
        {
            <MudAlert Severity="Severity.Error">
                Pull-out request not found.
            </MudAlert>
        }
        else
        {

   
            <MudText Typo="Typo.h5" Class="mb-4">Pull-Out Request #@PullOutRequest.Id</MudText>
            <MudCard Elevation="0" Class="d-flex flex-row align-items-center justify-content-end">
                @if (!IsEdit)
                {
                    <MudIconButton Color="Color.Success" Icon="@Icons.Material.Filled.Edit" OnClick="ToggleEdit" />
                }
                else
                {
                    <MudButton Color="Color.Info" StartIcon="@Icons.Material.Filled.Check" OnClick="ToggleEdit">Done</MudButton>
                }
            </MudCard>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText><b>Date Requested:</b> @PullOutRequest.DateRequest.ToString("MMM dd, yyyy")</MudText>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudText><b>Requested By:</b> @PullOutRequest.BranchRequestee.ToString()</MudText>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudText><b>Requested To:</b> @PullOutRequest.BranchRequestedTo.ToString()</MudText>
                </MudItem>

                <MudItem xs="12" md="4" lg="3"  Class="d-flex flex-row align-items-center gap-2">
                    <label class="fw-bold">Status:</label>
                    @if (!IsEdit)
                    {
                        <MudChip T="string"
                                 Color="@MapColor(UtilitiesHelper.GetStatusColorKey(PullOutRequest.Status))"
                                 Variant="Variant.Filled">
                            @UtilitiesHelper.GetStatusLabel(PullOutRequest.Status)
                        </MudChip>
                    }
                    else
                    {


                        <MudSelect T="DeliveryStatusOption"
                                   Value="PullOutRequest.Status"
                                   ValueChanged="@(async (DeliveryStatusOption value) => await OnPullOutStatusChange(value))"
                                   Variant="Variant.Text"
                                   Dense="true">

                            @foreach (DeliveryStatusOption status in Enum.GetValues(typeof(DeliveryStatusOption)))
                            {
                                <MudSelectItem T="DeliveryStatusOption"
                                               Value="status"
                                               Disabled="@(status == DeliveryStatusOption.Delivered
                                               && PullOutRequest.Status != DeliveryStatusOption.OnTheWay)">
                        @UtilitiesHelper.GetStatusLabel(status)
                    </MudSelectItem>
                                        }
                        </MudSelect>


                    }
                </MudItem>

                
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6">Requested Items</MudText>
         

            <MudTable Items="PullOutRequest.RequestProductItems" Dense="true" Hover="true" Class="mt-3 px-2" Elevation="5" Bordered=true>
                <HeaderContent>
                    <MudTh>Brand</MudTh>
                    <MudTh>Product Name</MudTh>
                    <MudTh>Requested Qty</MudTh>
                    <MudTh>Released Qty</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Remarks</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>@context.MasterProduct?.ProductBrand?.BrandName</MudTd>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.RequestedQuantity</MudTd>
                    <MudTd>@context.ReleasedQuantity</MudTd>
                    <MudTd>
                        @if (!IsEdit)
                        {
                            <MudChip T="string"
                                     Color="@(context.IsReceived ? Color.Info : Color.Warning)"
                                     Variant="Variant.Filled"
                                     Size="Size.Small">
                                @(context.IsReceived ? "Delivered" : "Pending")
                            </MudChip>
                        }
                        else
                        {
                            <MudSelect T="bool"
                                   Value="@context.IsReceived"
                                   Dense="true"
                                   Disabled="!IsEdit"
                                   ValueChanged="@(async (bool value) => await OnStatusChanged(value, context))">
                            <MudSelectItem T="bool" Value="false">
                                Pending
                            </MudSelectItem>
                            <MudSelectItem T="bool" Value="true">
                                Delivered
                            </MudSelectItem>
                        </MudSelect>
                        }
                    </MudTd>
                    <MudTd>@context.Remarks</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Typo="Typo.h6">No Records</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] {5,10,15,20}"/>
                </PagerContent>
            </MudTable>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6">Notes</MudText>
            <MudPaper Class="p-3 mt-2" Elevation="0" Outlined="false">
                <p>@PullOutRequest.Note</p>
            </MudPaper>

            <MudDivider Class="my-4" />

        
        }
    </MudCard>

</MudMainContent>

