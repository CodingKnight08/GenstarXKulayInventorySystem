@page "/pullouts"
<MudMainContent Class="w-auto d-flex flex-column align-items-center">
   <MudStack AlignItems="AlignItems.Center" Row=false Justify="Justify.Center" Class="w-100">
        <MudText Typo="Typo.h4" Class="my-4">Pull Out Deliveries</MudText>
        @if (!IsLoading)
        {
            <MudCard Class="p-4 w-100" Elevation="0">
                <MudTable Items="PullOuts" 
                        Hover="true"
                        Bordered="true" 
                        Striped="true" 
                        Dense="true" 
                        RowsPerPage="@PageTake"
                          CurrentPage="@PageSkip"
                          CurrentPageChanged="OnPageChanged"
                          RowsPerPageChanged="OnRowsPerPageChanged">
                    <HeaderContent>
                        <MudTh>Pull Out ID</MudTh>
                        <MudTh>Date Requested</MudTh>
                        <MudTh>Branch</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Pull Out ID">@context.Id.ToString("D10")</MudTd>
                        <MudTd DataLabel="Delivery Date">@context.DateRequest.ToString("MMMM dd,yyyy")</MudTd>
                        <MudTd DataLabel="Customer Name">@context.BranchRequestee.ToString()</MudTd>
                        <MudTd>@context.Status.ToString()</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Variant="Variant.Text" OnClick="() => ViewPullOut(context.Id)"/>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Align="Align.Center">No Pull Out Deliveries</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] {10,15,20}" />
                    </PagerContent>
                </MudTable>
            </MudCard>
        }
        else
        {
            <MudCard Elevation="10" Class="w-100 p-3 d-flex flex-column align-content-center justify-content-center gap-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Class="m-4" />    
                <MudText Typo="Typo.h6" Align="Align.Center">Loading</MudText>
            </MudCard>
        }
       
   </MudStack>
</MudMainContent>