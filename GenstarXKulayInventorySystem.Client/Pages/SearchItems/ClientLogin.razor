@page "/client-login"
@layout LoginLayout

<style>
    .login-page {
        height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        background: url('/clientbackground.png') center/cover no-repeat;
        position: relative;
    }

        /* dark overlay for depth */
        .login-page::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.55);
        }

    /* CARD */
    .login-card {
        position: relative;
        z-index: 2;
        width: 420px;
        padding: 32px;
        border-radius: 18px;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* LOGOS */
    .logo-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 10px;
    }

        .logo-row img {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid #eaeaea;
        }

    /* TEXT */
    .title {
        font-weight: 700;
        text-align: center;
        margin: 0;
    }

    .subtitle {
        text-align: center;
        color: gray;
        font-size: 14px;
        margin-bottom: 10px;
    }

    /* INPUT */
    .input-group {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #ddd;
        padding: 10px 12px;
        border-radius: 10px;
        background: #fff;
    }

        .input-group input {
            border: none;
            outline: none;
            flex: 1;
        }

    .toggle {
        cursor: pointer;
        color: gray;
    }

    /* ERROR */
    .error {
        color: #d32f2f;
        font-size: 12px;
        margin-top: -8px;
    }

    /* BUTTONS */
    .login-btn {
        background: linear-gradient(135deg, #00c853, #00b248);
        color: white;
        font-weight: bold;
        border-radius: 10px;
        padding: 10px;
    }

    .signup-btn {
        background: #1973E0;
        color: white;
        font-weight: bold;
        border-radius: 10px;
        padding: 10px;
    }
</style>
<MudPaper Class="login-page">

    <MudCard Class="login-card" Elevation="18">

        <!-- LOGO HEADER -->
        <div class="logo-row">
            <img src="/Genstar.png" alt="Genstar" />
            <img src="/Kulay.jpg" alt="Kulay" />
        </div>

        <h3 class="title">GENSTAR & KULAY REFERENCE</h3>
        <p class="subtitle">Sign in to continue</p>

        <!-- USERNAME -->
        <div class="input-group">
            <span class="material-icons">person</span>
            <input type="text"
                   placeholder="Username"
                   @bind-value="User.Username" />
        </div>

        @if (ShowValidation && string.IsNullOrWhiteSpace(User.Username))
        {
            <small class="error">Username is required</small>
        }

        <!-- PASSWORD -->
        <div class="input-group">
            <span class="material-icons">lock</span>
            <input type="@PasswordInputType"
                   placeholder="Password"
                   @bind-value="User.Password"
                   @onkeydown="HandleKeyDown" />

            <span class="material-icons toggle"
                  @onclick="TogglePasswordVisibility">
                @(ShowPassword ? "visibility_off" : "visibility")
            </span>
        </div>

        @if (ShowValidation && string.IsNullOrWhiteSpace(User.Password))
        {
            <small class="error">Password is required</small>
        }

        <!-- BUTTONS -->
        <MudButton Class="login-btn" OnClick="Login">
            Login
        </MudButton>

        <MudButton Class="signup-btn" OnClick="Register">
            Create Account
        </MudButton>

    </MudCard>

</MudPaper>