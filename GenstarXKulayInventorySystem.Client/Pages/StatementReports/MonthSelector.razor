<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6" Align="Align.Center">
                Select Month to Create Statement of Account
            </MudText>

            <MudGrid Spacing="5">
                <MudItem sm="12" md="6">
                    <MudSelect T="int" Label="Month" Value="SelectedMonth" ValueChanged="OnMonthChanged" Required="true">
                        @foreach (var month in AllowedMonths)
                        {
                            <MudSelectItem T="int" Value="@month.Value">@month.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem sm="12" md="6">
                    <MudSelect T="int" Label="Year" Value="SelectedYear" ValueChanged="OnYearChanged" Required="true">
                        @foreach (var year in AllowedYears)
                        {
                            <MudSelectItem T="int" Value="@year">@year</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            
           
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@IsLoading">
            Generate PDF
        </MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel" Disabled="@IsLoading">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>
